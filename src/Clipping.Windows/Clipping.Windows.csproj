<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- The Windows SDK version exposes the Windows.Graphics.Capture APIs, including
             GraphicsCaptureSession.IsBorderRequired. -->
        <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
        <!-- Lets this project build (not run) on macOS/Linux. -->
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <RootNamespace>Clipping.Windows</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <!-- Without per-monitor DPI awareness, Screen bounds are scaled on high-DPI
             displays and disagree with the dimensions of captured frames. -->
        <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Clipping.Core\Clipping.Core.csproj" />
    </ItemGroup>

</Project>
